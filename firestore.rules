rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Checks the users/{uid}.role field (your existing role system).
    // Safe only because the rule on /users below stops anyone but an admin
    // from setting this field — see the note there.
    function hasRole(role) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // Also checks the admins collection (your isAdmin() code check)
    function isAdmin() {
      return hasRole('admin') ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Missing role means an ordinary user; older docs predate the field.
    function roleOf(data) {
      return 'role' in data ? data.role : 'user';
    }

    // ── Admins collection ─────────────────────────────────────────────────────
    // Reading this is what triggered the permissions error.
    // Allow users to read their own admin doc (so the code check works),
    // and allow admins to manage others.
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // ── Resources ─────────────────────────────────────────────────────────────
    // The owner check used to read `resource.data.uploaderId`. Resource
    // documents store the uploader as `uploadedBy` — no document has ever had
    // an `uploaderId` — so that branch could never be true and, in practice,
    // only an admin could update or delete anything.
    //
    // Uploaders could not edit or remove their own uploads. More visibly,
    // every download counter bump and every like written by an ordinary
    // student was rejected, silently, in the browser. That is why download
    // counts sat in single figures and every like count in the library is
    // still zero.
    match /resources/{resourceId} {
      function ownsResource() {
        return isSignedIn() && request.auth.uid == resource.data.uploadedBy;
      }

      function touchesOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }

      function likedBefore() {
        return 'likedBy' in resource.data ? resource.data.likedBy : [];
      }

      function likedAfter() {
        return 'likedBy' in request.resource.data ? request.resource.data.likedBy : [];
      }

      allow read: if true;
      allow create: if isSignedIn();

      allow update: if ownsResource() || isAdmin()

        // A download raises the counter by exactly one and touches nothing
        // else. Open to logged-out visitors deliberately: browsing without an
        // account is the point of this site, so counting only signed-in
        // downloads would leave the trending row nearly as wrong as it is now.
        || (touchesOnly(['downloads'])
            && request.resource.data.downloads == resource.data.downloads + 1)

        // A like adds or removes the caller's own uid and moves the count one
        // step in the matching direction. The size checks are what stop
        // someone dropping other people from the list while adding themselves.
        || (isSignedIn() && touchesOnly(['likes', 'likedBy'])
            && (
                 (request.resource.data.likes == resource.data.likes + 1
                  && likedAfter().size() == likedBefore().size() + 1
                  && !(request.auth.uid in likedBefore())
                  && request.auth.uid in likedAfter())
                 ||
                 (request.resource.data.likes == resource.data.likes - 1
                  && likedAfter().size() == likedBefore().size() - 1
                  && request.auth.uid in likedBefore()
                  && !(request.auth.uid in likedAfter()))
               ));

      allow delete: if ownsResource() || isAdmin();
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // `role` is deliberately not self-writable.
    //
    // This was `allow write: if isOwner(userId) || isAdmin()`, while isAdmin()
    // above trusts users/{uid}.role. Together those meant any signed-in
    // student could write {role: "admin"} to their own profile from the
    // browser console and become a full admin — able to approve and delete any
    // upload, read the subscriber list, send blasts, and appoint other admins.
    // The app's own UI check reads the `admins` collection so nothing would
    // have looked different, but every rule in this file would have let them
    // through.
    //
    // An owner may still edit their own profile; they just cannot change the
    // one field that grants power. On an update `request.resource.data` is the
    // whole document after the merge, so an edit that does not mention `role`
    // still compares equal and passes.
    match /users/{userId} {
      allow read: if true;
      allow create: if isAdmin() ||
        (isOwner(userId) && roleOf(request.resource.data) == 'user');
      allow update: if isAdmin() ||
        (isOwner(userId) && roleOf(request.resource.data) == roleOf(resource.data));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── Subscribers (newsletter sign-ups) ─────────────────────────────────────
    // Anyone (including logged-out guests) can subscribe via the popup
    match /subscribers/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Campaigns (sent email archive) ────────────────────────────────────────
    match /campaigns/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Wishlist (correct path: wishlist → not wishlists) ─────────────────────
    // Code path: db.collection("wishlist").doc(uid).collection("items")
    match /wishlist/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }

    // ── Comments (correct path: top-level comments collection) ───────────────
    // Code path: db.collection("comments").doc(resourceId).collection("messages")
    match /comments/{resourceId}/messages/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        (request.auth.uid == resource.data.uid || isAdmin());
    }

    // ── Newsletter search cooldowns (managed by serverless API) ───────────────
    match /newsletter_cooldowns/{docId} {
      allow read, write: if true;
    }

    // ── Email blast cooldowns (managed by serverless API) ─────────────────────
    match /blast_cooldowns/{docId} {
      allow read, write: if true;
    }

    // ── Campus Moments (student photo wall) ──────────────────────────────────
    // Visible to everyone, including logged-out visitors. Only a signed-in
    // user can post, and the document must be stamped with their own uid so a
    // post cannot be attributed to someone else. Deletion is the author's or
    // an admin's.
    match /moments/{docId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uploaderId == request.auth.uid
        && request.resource.data.imageUrl is string
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 60;
      allow update: if isAdmin();
      allow delete: if isSignedIn() &&
        (request.auth.uid == resource.data.uploaderId || isAdmin());
    }

    // ── Email opt-outs (written by the unsubscribe API, read by the blast) ────
    // Open like the cooldown collections above — the API routes use the client
    // SDK, so they authenticate as an anonymous caller.
    match /unsubscribes/{docId} {
      allow read, write: if true;
    }

  }
}
