# ---- Firebase (client) — required for auth + firestore ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Cloudinary — required for uploads ----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- App ----
# Local development only. In production this MUST be the public site URL,
# e.g. https://campusvaultgbpiet.vercel.app
# Leaving localhost here in a hosted environment puts unreachable links in
# every outgoing email and badly hurts spam scoring. (The email code now
# refuses to use a local address, but set it correctly anyway.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Optional ----
NEXT_PUBLIC_GA_ID=
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=
